{
  "name": "appspace-portal",
  "version": "0.7.41",
  "private": true,
  "description": "AppSpace: portal offline de aplicativos para desktop Electron e Android Capacitor",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "desktop:exe": "electron-builder --win portable --publish never",
    "build:web": "node scripts/build-web.cjs",
    "check": "node scripts/verify.cjs",
    "mobile:add": "npm run build:web && cap add android && node scripts/prepare-mobile-lan.cjs && node scripts/prepare-label-documents.cjs",
    "mobile:sync": "npm run build:web && cap sync android && node scripts/prepare-mobile-lan.cjs && node scripts/prepare-label-documents.cjs",
    "mobile:open": "cap open android",
    "mobile:run": "npm run mobile:sync && cap run android",
    "ai:agent": "node desktop/ai/cli.cjs",
    "ai:test": "node --test scripts/test-ai-agent.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capgo/capacitor-updater": "8.51.15",
    "extract-zip": "2.0.1",
    "@capgo/capacitor-printer": "8.1.8",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.k410sh4.appspace.desktop",
    "productName": "AppSpace",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "index.html",
      "assets/**/*",
      "apps/**/*",
      "configuracoes.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "AppSpace-${version}-${arch}.${ext}",
    "asarUnpack": [
      "desktop/rgb-direct.ps1"
    ]
  }
}
